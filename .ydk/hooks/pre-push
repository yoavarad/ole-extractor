#!/bin/sh
# Skip verification if ydk task done already ran it recently
VERIFIED_FLAG=".ydk/.verified"
if [ -f "$VERIFIED_FLAG" ]; then
  VERIFIED_TS=$(cat "$VERIFIED_FLAG")
  NOW=$(python -c "import time; print(time.time())")
  AGE=$(python -c "print(float('$NOW') - float('$VERIFIED_TS'))")
  EXPIRED=$(python -c "print(1 if float('$AGE') > 300 else 0)")
  if [ "$EXPIRED" = "0" ]; then
    echo "Pre-push: skipping verification (ydk task done verified recently)"
    rm -f "$VERIFIED_FLAG"
    exit 0
  fi
  rm -f "$VERIFIED_FLAG"
fi
ydk verify run --trigger pre-push
