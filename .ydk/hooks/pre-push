#!/bin/sh
# Local mirror of the PR gates. Base is the ydk 1.5.0 generated hook (`ydk hooks pre-push`,
# which runs the git:pre-push plugins and honors the .ydk/.verified flag from `ydk task done`);
# re-running `ydk init --force` would drop the branch-name check below, so re-add it.

# Branch name: same regex as the "Branch name" job in .github/workflows/ydk-pr-checks.yml.
# git feeds "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin.
zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac
  branch=${remote_ref#refs/heads/}
  [ "$branch" = main ] && continue
  [ "$local_sha" = "$zero" ] && continue
  if ! echo "$branch" | grep -qE '^(feat|fix|docs|chore|refactor|test|ci|perf|release|task)/[a-z0-9-]+$'; then
    echo "pre-push: branch '$branch' does not follow convention type/description (ydk-pr-checks would fail)" >&2
    echo "Valid types: feat fix docs chore refactor test ci perf release task" >&2
    exit 1
  fi
done

export PYTHONIOENCODING=utf-8
exec ydk hooks pre-push
