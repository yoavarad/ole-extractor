# .NET build output
bin/
obj/

# Visual Studio
.vs/
*.user
*.suo

# Rider / VS Code
.idea/
.vscode/

# graphify working files (graph.json/GRAPH_REPORT.md/graph.html are kept)
graphify-out/*.graphify_*
ExtractorOle/graphify-out/
graphify-out/cache/
graphify-out/20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
*.graphify-bak

# ydk verification cache and stale automated (Bedrock-failed) reports
# -- see docs/adrs/003-manual-spec-review-in-place-of-bedrock.md;
# the real record is .ydk/reports/spec-verify-manual-*.md
.ydk/cache/
.ydk/reports/spec-verify-2*.json
.ydk/reports/spec-verify-2*.txt
.ydk/spec-check-results.json

# ydk machine-local / regenerable state -- must not be tracked:
# worktrees are live git worktrees (nested .git, would corrupt the repo);
# active-task.json and .verified are transient per-session markers;
# memory/ is a regenerable ChromaDB index (ydk memory index).
.ydk/worktrees/
.ydk/active-task.json
.ydk/.verified
.ydk/memory/
