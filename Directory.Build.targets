<Project>
  <!--
    Workaround for the third_party/b2xtranslator submodule's Ppt project (ADR-004).

    b2xtranslator.ppt.csproj is SDK-style but never declares its PresentationMLMapping/Defaults/**/*.xml
    files (theme, clrMap, slideLayouts) as embedded resources, yet PresentationMLMapping.Utils.
    GetDefaultDocument loads them via Assembly.GetManifestResourceStream("b2xtranslator.
    PresentationMLMapping.Defaults.<name>.xml"). Without them every real .ppt -> .pptx conversion
    throws a NullReferenceException. Declared here, scoped to that one project, rather than by
    editing the submodule; setting RootNamespace to "b2xtranslator" makes the SDK's default
    manifest-resource naming (RootNamespace + relative path with dots) produce exactly the names the
    code looks up. Drop this once the fork's csproj carries the same fix.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'b2xtranslator.ppt'">
    <RootNamespace>b2xtranslator</RootNamespace>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'b2xtranslator.ppt'">
    <EmbeddedResource Include="PresentationMLMapping\Defaults\**\*.xml" />
  </ItemGroup>
  <!--
    NuGet audit: third_party/npoi pins SixLabors.ImageSharp 2.1.11 (central package management), which
    has five known advisories and fails restore (NU1902/NU1903 as errors). 2.1.13, the last 2.1.x, is
    still flagged for all five; fixes exist only in ImageSharp 3.x, a major upgrade NPOI 2.x does not
    support. Suppress exactly these five, scoped to NPOI projects (this tool only parses local legacy
    Office files). Not NuGetAudit=false repo-wide. Revisit when the NPOI fork bumps ImageSharp.
  -->
  <ItemGroup Condition="$(MSBuildProjectDirectory.Replace('\', '/').Contains('/third_party/npoi/'))">
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
  </ItemGroup>
</Project>
