root = true

# end_of_line is intentionally not set: the repo uses core.autocrlf=true (CRLF working tree on Windows).
[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.cs]
indent_size = 4
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_require_accessibility_modifiers = always:suggestion

# Analyzer guardrails from csharp-development-best-practices.
# Warnings become build errors in CI (CiWarningsAsErrors=true, Directory.Build.props).
# Async (section 4): no sync-over-async, forward CancellationToken.
dotnet_diagnostic.CA1849.severity = warning
dotnet_diagnostic.VSTHRD002.severity = warning
dotnet_diagnostic.CA2016.severity = warning
# Logging (section 3): structured message templates, LoggerMessage delegates.
dotnet_diagnostic.CA1848.severity = warning
dotnet_diagnostic.CA2254.severity = warning
# ConfigureAwait(false) is only required in the library project (see below).
dotnet_diagnostic.CA2007.severity = none

# Library project (no app host or test framework): require ConfigureAwait(false).
[ExtractorOle/ExtractorOLE/**.cs]
dotnet_diagnostic.CA2007.severity = warning

# Test project: Method_Scenario_Expected names use underscores by convention (xUnit).
[ExtractorOle/ExtractorOLE.Tests/**.cs]
dotnet_diagnostic.CA1707.severity = none

# Vendored submodules (NPOI, b2xtranslator): upstream code, never analyzed or reformatted here.
[third_party/**]
generated_code = true
dotnet_analyzer_diagnostic.severity = none

[*.{json,yml,yaml}]
indent_size = 2

[*.csproj]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
